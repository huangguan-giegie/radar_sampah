	id VARCHAR(100) NOT NULL, 
	beach_id VARCHAR(80) NOT NULL, 
	starts_at DATETIME NOT NULL, 
	ends_at DATETIME NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	source VARCHAR(20) NOT NULL, 
	meeting_point VARCHAR(160), 
	created_by VARCHAR(80), 
	created_at DATETIME NOT NULL, 
	updated_at DATETIME NOT NULL, 
	PRIMARY KEY (id), 
	CONSTRAINT community_events_beach_start UNIQUE (beach_id, starts_at)
)o␀O␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀9M'␀indexsqlite_autoindex_report_photos_1report_photos7K%␀indexsqlite_autoindex_area_species_2area_species7K%␀indexsqlite_autoindex_area_species_1area_speciesç>%%ö?tablearea_speciesarea_speciesCREATE TABLE area_species (
	id VARCHAR(36) NOT NULL, 
	area_id VARCHAR(80) NOT NULL, 
	species_id VARCHAR(36), 
	kind VARCHAR(20) NOT NULL, 
	display_name VARCHAR(160) NOT NULL, 
	glyph VARCHAR(20) NOT NULL, 
	text TEXT NOT NULL, 
	sort_order INTEGER NOT NULL, 
	origin VARCHAR(20) NOT NULL, 
	source_dataset VARCHAR(20) NOT NULL, 
	source_citation TEXT NOT NULL, 
	source_url VARCHAR(500), 
	source_accessed_at DATE, 
	occurrence_state VARCHAR(20) NOT NULL, 
	occurrence_score INTEGER, 
	occurrence_basis TEXT, 
	PRIMARY KEY (id), 
	CONSTRAINT area_species_area_species_key UNIQUE (area_id, species_id), 
	CONSTRAINT area_species_kind_check CHECK (kind IN ('species','habitat','group')), 
	CONSTRAINT area_species_glyph_check CHECK (glyph IN ('turtle','bird','mangrove','grass','crab','fish')), 
	CONSTRAINT area_species_origin_check CHECK (origin IN ('curated','derived')), 
	CONSTRAINT area_species_source_dataset_check CHECK (source_dataset IN ('FishBase','OBIS','other','pending')), 
	CONSTRAINT area_species_occurrence_state_check CHECK (occurrence_state IN ('ready','pending','unavailable')), 
	CONSTRAINT area_species_occurrence_score_check CHECK (occurrence_score IS NULL OR occurrence_score BETWEEN 0 AND 100), 
	CONSTRAINT area_species_kind_species_check CHECK ((kind = 'species') = (species_id IS NOT NULL)), 
	CONSTRAINT area_species_occurrence_state_score_check CHECK ((occurrence_score IS NULL) = (occurrence_state <> 'ready')), 
	CONSTRAINT area_species_occurrence_basis_check CHECK (occurrence_score IS NULL OR occurrence_basis IS NOT NULL), 
	FOREIGN KEY(area_id) REFERENCES beaches (id) ON DELETE CASCADE, 
	FOREIGN KEY(species_id) REFERENCES dim_species (species_id)
)␀␀␀j␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ç$''Ñtablereport_photosreport_photosCREATE TABLE report_photos (
	photo_key VARCHAR(500) NOT NULL, 
	owner_id VARCHAR(80) NOT NULL, 
	mime VARCHAR(64) NOT NULL, 
	data BLOB NOT NULL, 
	created_at DATETIME NOT NULL, 
