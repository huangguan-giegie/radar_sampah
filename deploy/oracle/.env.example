# Initial IP-only testing:
SITE_ADDRESS=:80

# Production application settings.
RADAR_ENV=production
PORT=5000
TRUST_PROXY_HEADERS=1

# Copy these values from the current Render production service.
DATABASE_URL=postgresql://replace-me
AUTH_JWT_SECRET=replace-me
GEO_PRIVACY_HMAC_KEY=replace-me

# Optional variables: copy them only if they are currently set in production.
# DATABASE_SCHEMA=
# DEMO_PARTICIPANT_ID=
# LITTER_RECOGNITION_ENABLED=
# LITTER_RECOGNITION_API_URL=
# LITTER_RECOGNITION_API_KEY=
