# Initial public-IP validation:
SITE_ADDRESS=:80

RADAR_ENV=production
PORT=5000
TRUST_PROXY_HEADERS=1
LITTER_PRELOAD=true
EVENT_SCHEDULER_TTL_SECONDS=60
INSIGHTS_CACHE_TTL_SECONDS=60
RADAR_PREWARM_PUBLIC_VIEWS=1

# Copy these exact values from the current Render production service.
DATABASE_URL=postgresql://replace-me
AUTH_JWT_SECRET=replace-me
GEO_PRIVACY_HMAC_KEY=replace-me

# Optional variables: copy only if currently set in production.
# DATABASE_SCHEMA=
# DEMO_PARTICIPANT_ID=
# LITTER_RECOGNITION_ENABLED=
# LITTER_RECOGNITION_API_URL=
# LITTER_RECOGNITION_API_KEY=
# LITTER_ONNX_MODEL_PATH=
# LITTER_MODEL_VERSION=
# LITTER_INFERENCE_SIZE=
