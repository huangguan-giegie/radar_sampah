# Generate a random secret once; keep it unchanged across restarts.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Local-only default; production requires a PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///radar_sampah.db
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=5000
# Optional stable dedicated secret; otherwise derived from AUTH_JWT_SECRET.
# GEO_PRIVACY_HMAC_KEY=replace-with-another-random-secret
# Optional deployment schema; use a separate schema when reviewing against an existing database.
# DATABASE_SCHEMA=radar_v2
